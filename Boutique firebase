// ============================================================
// boutique-firebase.js : tout le code Firebase en un seul fichier
// Firebase JS SDK v9+ (modulaire). Colle ce fichier une seule fois.
// ============================================================
import {
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  signOut,
} from "firebase/auth";
import {
  doc,
  getDoc,
  collection,
  addDoc,
  writeBatch,
  runTransaction,
  serverTimestamp,
  Timestamp,
} from "firebase/firestore";

// Moyens de paiement : doivent être identiques à la liste dans firestore.rules
export const MOYENS_PAIEMENT = ["orange_money", "mtn_momo", "cash", "virement"];
export const TYPES_COMMERCE = ["boutique", "boulangerie", "pharmacie", "quincaillerie", "restaurant"];

// ------------------------------------------------------------
// 1. INSCRIPTION (nom du point de vente, email, mot de passe, moyen de paiement)
//    Crée le compte + la boutique + le patron + le lien users en UN SEUL batch.
// ------------------------------------------------------------
function creerIdBoutique(nom) {
  const base = nom
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // enlève les accents
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 22);
  const suffixe = Math.random().toString(36).slice(2, 7);
  return `${base || "boutique"}-${suffixe}`; // respecte [a-z0-9-]{3,30}
}

export async function inscrire(auth, db, { nom, email, motDePasse, payMethod, type = "boutique" }) {
  if (!nom || !nom.trim()) throw new Error("Nom du point de vente obligatoire");
  if (!email) throw new Error("Email obligatoire");
  if (!motDePasse || motDePasse.length < 6) throw new Error("Mot de passe : 6 caractères minimum");
  if (!MOYENS_PAIEMENT.includes(payMethod)) throw new Error("Moyen de paiement invalide");
  if (!TYPES_COMMERCE.includes(type)) throw new Error("Type de commerce invalide");

  const cred = await createUserWithEmailAndPassword(auth, email, motDePasse);
  const uid = cred.user.uid;
  const shopId = creerIdBoutique(nom);

  const batch = writeBatch(db);
  batch.set(doc(db, "shops", shopId), {
    name: nom.trim().slice(0, 60),
    type,
    plan: "complet",
    blocked: false,
    trial: true,
    ownerUid: uid,
    ownerEmail: email,
    accessUntil: Timestamp.fromDate(new Date(Date.now() + 48 * 3600 * 1000)), // essai 48 h
    payMethod,
  });
  batch.set(doc(db, "shops", shopId, "members", uid), { role: "patron", email });
  batch.set(doc(db, "users", uid), { shop: shopId });

  await batch.commit();
  return shopId;
}

// ------------------------------------------------------------
// 2. CONNEXION : retrouve la boutique et le rôle automatiquement
// ------------------------------------------------------------
export async function connecter(auth, db, email, motDePasse) {
  const cred = await signInWithEmailAndPassword(auth, email, motDePasse);
  const uid = cred.user.uid;

  const lien = await getDoc(doc(db, "users", uid));
  if (!lien.exists()) throw new Error("Aucune boutique liée à ce compte");
  const shopId = lien.data().shop;

  const membre = await getDoc(doc(db, "shops", shopId, "members", uid));
  if (!membre.exists()) throw new Error("Accès retiré par le patron");

  const boutique = await getDoc(doc(db, "shops", shopId));
  const b = boutique.data();
  const expire = b.accessUntil.toDate() < new Date();

  return {
    uid,
    shopId,
    role: membre.data().role, // patron | vendeur | comptable
    boutique: b,
    accesActif: !b.blocked && !expire,
  };
}

export function deconnecter(auth) {
  return signOut(auth);
}

// ------------------------------------------------------------
// 3. VENTE : enregistre la vente + baisse le stock + écrit la trace (transaction)
//    donneesVente ne doit PAS contenir "by" (ajouté automatiquement).
// ------------------------------------------------------------
export async function enregistrerVente(db, uid, shopId, productId, quantite, donneesVente) {
  if (!(quantite > 0)) throw new Error("Quantité invalide");

  const prodRef = doc(db, "shops", shopId, "products", productId);
  const logRef = doc(collection(db, "shops", shopId, "stockLogs"));
  const saleRef = doc(collection(db, "shops", shopId, "sales"));

  await runTransaction(db, async (tx) => {
    const snap = await tx.get(prodRef);
    const ancien = snap.data().stock;
    const nouveau = ancien - quantite;
    if (nouveau < 0) throw new Error("Stock insuffisant");

    tx.set(logRef, {
      product: productId,
      old: ancien,
      new: nouveau,
      by: uid,
      at: serverTimestamp(),
    });
    tx.update(prodRef, { stock: nouveau, lastLog: logRef.id });
    tx.set(saleRef, { ...donneesVente, by: uid });
  });

  return saleRef.id;
}

// ------------------------------------------------------------
// 4. CHANGER LE STOCK À LA MAIN (réapprovisionnement / correction) : patron seulement
// ------------------------------------------------------------
export async function changerStock(db, uid, shopId, productId, nouveau) {
  if (!(nouveau >= 0)) throw new Error("Stock invalide");

  const prodRef = doc(db, "shops", shopId, "products", productId);
  const logRef = doc(collection(db, "shops", shopId, "stockLogs"));

  await runTransaction(db, async (tx) => {
    const snap = await tx.get(prodRef);
    const ancien = snap.data().stock;

    tx.set(logRef, {
      product: productId,
      old: ancien,
      new: nouveau,
      by: uid,
      at: serverTimestamp(),
    });
    tx.update(prodRef, { stock: nouveau, lastLog: logRef.id });
  });
}

// ------------------------------------------------------------
// 5. ANNULER UNE VENTE (patron) : on n'efface rien, on ajoute une trace signée
//    Si la marchandise revient en rayon, appelle ensuite changerStock().
//    Dans l'interface, ne compte pas dans les totaux les ventes qui ont une entrée dans "voids".
// ------------------------------------------------------------
export async function annulerVente(db, uid, shopId, saleId, motif) {
  if (!motif || !motif.trim()) throw new Error("Motif obligatoire");

  await addDoc(collection(db, "shops", shopId, "voids"), {
    sale: saleId,
    reason: motif.trim(),
    by: uid,
    at: serverTimestamp(),
  });
}
