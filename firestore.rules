rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == 'PQ15rICcjFSALPRUsWQxaVxuXFH3'; }
    function shopDoc(s) { return /databases/$(database)/documents/shops/$(s); }
    function memberDoc(s) { return /databases/$(database)/documents/shops/$(s)/members/$(request.auth.uid); }
    function isMember(s) { return signedIn() && exists(memberDoc(s)); }
    function hasRole(s, roles) { return isMember(s) && get(memberDoc(s)).data.role in roles; }
    function active(s) {
      let d = get(shopDoc(s)).data;
      return d.get('blocked', false) == false && d.accessUntil > request.time;
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow write: if admin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['shop'])
        && request.resource.data.shop is string
        && (request.auth.uid == uid || hasRole(request.resource.data.shop, ['patron']));
    }

    match /shops/{shop} {
      allow read: if admin() || isMember(shop);
      allow write: if admin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','type','plan','blocked','trial','ownerUid','ownerEmail','accessUntil'])
        && request.resource.data.keys().hasAll(['name','type','plan','blocked','trial','ownerUid','ownerEmail','accessUntil'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plan == 'complet'
        && request.resource.data.blocked == false
        && request.resource.data.trial == true
        && request.resource.data.type in ['boutique','boulangerie','pharmacie','quincaillerie','restaurant']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.ownerEmail is string
        && request.resource.data.accessUntil is timestamp
        && request.resource.data.accessUntil <= request.time + duration.value(10, 'd')
        && shop.matches('[a-z0-9-]{3,30}');

      match /members/{uid} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid) || hasRole(shop, ['patron']);
        allow write: if admin();
        allow create: if hasRole(shop, ['patron']) && active(shop)
          && request.resource.data.keys().hasOnly(['role','email'])
          && request.resource.data.role in ['vendeur','comptable'];
        allow delete: if hasRole(shop, ['patron']) && uid != request.auth.uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role','email'])
          && request.resource.data.role == 'patron'
          && getAfter(shopDoc(shop)).data.ownerUid == uid;
      }

      match /products/{id} {
        allow read: if admin() || hasRole(shop, ['patron','vendeur']);
        allow create, delete: if hasRole(shop, ['patron']) && active(shop);
        allow update: if active(shop) && (
          hasRole(shop, ['patron']) ||
          (hasRole(shop, ['vendeur'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock is number
            && request.resource.data.stock >= 0
            && request.resource.data.stock <= resource.data.stock)
        );
      }

      match /sales/{id} {
        allow read: if admin() || hasRole(shop, ['patron','vendeur','comptable']);
        allow create: if hasRole(shop, ['patron','vendeur']) && active(shop)
          && request.resource.data.by == request.auth.uid;
        allow delete: if hasRole(shop, ['patron']) && active(shop);
        allow update: if false;
      }

      match /expenses/{id} {
        allow read: if admin() || hasRole(shop, ['patron','comptable']);
        allow create, update, delete: if hasRole(shop, ['patron']) && active(shop);
      }

      match /debts/{id} {
        allow read: if admin() || hasRole(shop, ['patron','vendeur']);
        allow create: if active(shop) && (
          hasRole(shop, ['patron']) ||
          (hasRole(shop, ['vendeur']) && request.resource.data.paid == 0)
        );
        allow update: if active(shop) && (
          hasRole(shop, ['patron']) ||
          (hasRole(shop, ['vendeur'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid'])
            && request.resource.data.paid >= resource.data.paid)
        );
        allow delete: if hasRole(shop, ['patron']) && active(shop);
      }

      match /{other=**} {
        allow read, write: if admin();
      }
    }
  }
}
